#!/bin/sh
# Refresh the snapshot when the working branch or revision changes.
repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo_root/scripts/update_project_archive.ps1" \
  -ReleaseStatus "source checkout refreshed" \
  -TestSummary "See 04_分析与验证/当前版本验收.md" >/dev/null 2>&1 || true
exit 0
